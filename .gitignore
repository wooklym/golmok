# Unreal generated
unreal/Golmok/Binaries/
unreal/Golmok/Intermediate/
unreal/Golmok/Saved/
unreal/Golmok/DerivedDataCache/
unreal/Golmok/.vs/
unreal/Golmok/*.sln
unreal/Golmok/.vsconfig
unreal/Golmok/Plugins/*/Binaries/
unreal/Golmok/Plugins/*/Intermediate/
build/
# Cesium for Unreal's HTTP request cache (created in the project folder whenever the plugin loads)
unreal/Golmok/cesium-request-cache.sqlite*

# Recreated by script in each checkout: UE mannequin pack (tools/ue/add-mannequin.ps1)
# and the movement test level (golmok.setup_dev_level, or tools/ue/test.ps1 -SetupDevLevel)
unreal/Golmok/Content/Characters/
unreal/Golmok/Content/Golmok/Maps/L_Dev.umap

# Raw captures, reconstruction projects and model weights never go in git (D-005, D-007)
data/
captures_raw/
*.dng
*.heic
*.mov
*.mp4
*.ply
*.rsproj
*.psht
*.jit
tools/models/

# Python
__pycache__/
*.egg-info/
.venv/
.pytest_cache/

# Review viewer
tools/viewer/node_modules/
tools/viewer/test/out/
tools/viewer/package-lock.json

# Recreated by editor Python (golmok.basemap_import / golmok.materials) from the basemap output (~130 MB)
unreal/Golmok/Content/Golmok/Basemap/
unreal/Golmok/Content/Golmok/Maps/L_Basemap_*
unreal/Golmok/Content/Golmok/Materials/M_Basemap*

# V-03: assets the editor Python (golmok.synthetic_zone) regenerates; never committed (L_ZoneTest map, synthetic zone meshes and the interior sublevel)
unreal/Golmok/Content/Golmok/Maps/L_ZoneTest.umap
unreal/Golmok/Content/Golmok/Zones/z_synthetic_001/v1/*.uasset
unreal/Golmok/Content/Golmok/Zones/z_synthetic_001_interior/v1/*.uasset
unreal/Golmok/Content/Golmok/Zones/z_synthetic_001_interior/v1/*.umap
# WP-06: the synthetic scan zones make_synthetic_zone + zone_import/interior_setup regenerate (assets, sublevel,
# copied manifest.json/blockers.json; pc-findings #6). /Game/Golmok/Materials/M_ZoneScan* and T_ZoneScanDefault*
# are product assets and stay committable.
unreal/Golmok/Content/Golmok/Zones/z_synthetic_scan_001*/
# WP-06: golmok.spike_runner.save_layer_levels copies of the open map (L_Spike_b / L_Spike_c / L_Spike_ac, plus any _BuiltData)
unreal/Golmok/Content/Golmok/Maps/L_Spike_*
# WP-06 runbook §0: the L_ZoneTest copy used for V-04 (fixture zone removed) and its viewpoints file
unreal/Golmok/Content/Golmok/Maps/L_ZoneTest06*
unreal/Golmok/Config/Golmok/Viewpoints/L_ZoneTest06.json
# WP-09 runbook §4: the L_ZoneTest copy with the placed Zone_* actors removed (index discovery test), plus its _BuiltData
unreal/Golmok/Content/Golmok/Maps/L_ZoneTest09*
